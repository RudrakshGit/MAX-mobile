{
  "expo": {
    "name": "MAX",
    "slug": "max-companion",
    "version": "1.8.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "max",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FCF8EE",
    "android": {
      "package": "com.eg18.max",
      "adaptiveIcon": {
        "backgroundColor": "#FCF8EE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 16,
      "allowBackup": false
    },
    "web": {
      "output": "server"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-async-storage-size",
      "./plugins/with-usage-queries",
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#1B1A18"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCF8EE",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#1B1A18"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ]
          }
        }
      ],
      "expo-sharing",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "MAX needs microphone access to record voice journal entries.",
          "enableBackgroundPlayback": true
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cde1f24a-59eb-49f3-ae67-5145cc3f3542"
      }
    },
    "owner": "max-major-project"
  }
}
